name: Build H96 H616

on:
  workflow_dispatch:
    inputs:
      release:
        description: 'Release'
        default: 'trixie'

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 1

      - name: Build
        run: |
          ./compile.sh \
            BOARD=h96-h616 \
            RELEASE=trixie \
            BUILD_MINIMAL=yes \
            BUILD_DESKTOP=no \
            KERNEL_CONFIGURE=no \
            COMPRESS_OUTPUTIMAGE=sha,img \
            USE_GITHUBACTIONS=yes

      - name: Upload
        uses: actions/upload-artifact@v4
        with:
          name: armbian-h96-h616
          path: output/images/*.img*
